Kubernetes Container Orchestration
nano deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-deployment
spec:
  replicas: 2
  selector:
    matchLabels:
      app: myapp
  template:
    metadata:
      labels:
        app: myapp
    spec:
      containers:
      - name: nginx
        image: nginx
        ports:
        - containerPort: 80

kubectl apply -f deployment.yaml
kubectl get deployments
kubectl get pods
kubectl get all
kubectl delete deployment my-deployment
