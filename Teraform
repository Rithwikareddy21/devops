Teraform
mkdir terraform-demo
cd terraform-demo
nano main.tf
terraform {
  required_providers {
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

resource "local_file" "example" {
  filename = "hello.txt"
  content  = "Hello from Terraform!"
}
terraform init
terraform validate
terraform plan
terraform apply
cat hello.txt
terraform destroy
